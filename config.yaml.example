model:
  name: "vit_large_patch16_dinov3.lvd1689m"
  pretrained: true
  input_size: 224

dataset:
  split:
    val_ratio: 0.15
    test_ratio: 0.15
    seed: 42
  resample:
    enabled: true
    method: "fixed_count" # 選項: "fixed_count" 或 "ratio"
    target: 200           # 每個類別目標數量
    per_class: true       # 確保類別均衡

train:
  batch_size: 8
  epochs: 30
  lr: 0.00002
  weight_decay: 0.01
